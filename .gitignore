# Byte-compiled / optimized / DLL files (recursively)
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Virtual environment
venv/
.env
.env.*
**/.env
**/.env.*

# Ignore everything inside uploads/, even nested
uploads/**
!uploads/.gitkeep  # exception for .gitkeep

# Packaging
build/
dist/
**/*.egg-info/
*.egg

# IDE settings (recursively)
.vscode/
.idea/
**/.vscode/
**/.idea/

# Logs, runtime, database
**/*.log
**/*.pid
**/*.db
**/*.sqlite3

# Testing, type-checking
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.cache/
.pyre/

# Notebooks
**/.ipynb_checkpoints

# OS-specific files
.DS_Store
Thumbs.db

# Compiled extensions
**/*.pyd

# Docker
docker-compose.override.yml

# Static/Media (if used)
staticfiles/
media/
